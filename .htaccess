# InfersioAI — Apache (e.g. AWS Lightsail / XAMPP)
# Helps banner video stream correctly on production (MIME, ranges, no gzip on video).

Options +FollowSymLinks

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Admin uploads live in storage/uploads/ (gitignored) — serve at /uploads/...
    RewriteRule ^uploads/(.*)$ storage/uploads/$1 [L]
</IfModule>

<IfModule mod_mime.c>
    AddType video/webm .webm
    AddType video/mp4 .mp4
    AddType video/quicktime .mov
</IfModule>

# Byte-range requests let the browser buffer and play before the full file downloads.
<IfModule mod_headers.c>
    Header set Accept-Ranges bytes
</IfModule>

# Long cache for static media (adjust after deploy if you replace files often).
<IfModule mod_headers.c>
    <FilesMatch "\.(webm|mp4|webp|png|jpg|jpeg|gif|svg|ico|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# Never gzip video — wastes CPU and can break streaming / range requests on some hosts.
<IfModule mod_deflate.c>
    SetEnvIfNoCase Request_URI \.(webm|mp4|mov|avi|m4v)$ no-gzip dont-vary
</IfModule>
<IfModule mod_setenvif.c>
    SetEnvIfNoCase Request_URI \.(webm|mp4|mov|avi|m4v)$ no-gzip dont-vary
</IfModule>
